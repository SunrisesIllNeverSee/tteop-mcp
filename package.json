{
  "name": "tteop-mcp",
  "version": "0.2.0",
  "mcpName": "io.github.SunrisesIllNeverSee/tteop-mcp",
  "description": "Production MCP server for TTEOP — Token Telemetry Evaluation Operator Protocol. Build, validate, and describe TTEOP telemetry envelopes via the Model Context Protocol.",
  "type": "module",
  "bin": {
    "tteop-mcp": "bin/tteop-mcp.mjs"
  },
  "scripts": {
    "start": "node bin/tteop-mcp.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node bin/tteop-mcp.mjs",
    "test": "node test/test-mcp-client.mjs",
    "test:packaged": "node test/test-packaged-tarball.mjs"
  },
  "keywords": [
    "tteop",
    "mcp",
    "model-context-protocol",
    "token-efficiency",
    "telemetry",
    "ai-operators",
    "conformance",
    "protocol",
    "yield",
    "leverage",
    "sigrank"
  ],
  "author": "Deric J McHenry <hello@signalaf.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/SunrisesIllNeverSee/tteop-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/SunrisesIllNeverSee/tteop-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/SunrisesIllNeverSee/tteop-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "tteop-spec": "0.1.4-draft",
    "zod": "4.5.4"
  },
  "files": [
    "bin/",
    "src/",
    "server.json",
    "README.md",
    "LICENSE"
  ]
}
